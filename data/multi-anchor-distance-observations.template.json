{
  "schemaVersion": 3,
  "description": "Template only. Do not add values until measured length, uncertainty and exact endpoint coordinate provenance are all available.",
  "measurementPolicy": {
    "eligibleTypes": [
      "direct-straight-line",
      "direct-survey-baseline",
      "direct-survey-reduced-horizontal"
    ],
    "surveyBaseline": {
      "measurementBasis": "adjusted-horizontal",
      "requiredFields": [
        "split",
        "a",
        "b",
        "distanceKm",
        "measurementType",
        "measurementBasis",
        "uncertaintyKm",
        "source.provider",
        "source.reference",
        "source.groupId",
        "a.coordinateSource.provider",
        "a.coordinateSource.reference",
        "b.coordinateSource.provider",
        "b.coordinateSource.reference"
      ]
    },
    "splitPolicy": "Hold out complete baseline/site groups, not individual adjacent segments.",
    "coordinatePolicy": "Coordinates must identify the exact monument endpoints and have their own provider/reference. Approximate site-centre coordinates are not acceptable.",
    "sourcePolicy": "Record measured horizontal distance, its stated uncertainty and the source certificate or dataset row. Never derive distance from coordinates.",
    "excludedTargets": [
      "ADS-B flown mileage",
      "flight track length",
      "shortest route distance",
      "travel time multiplied by speed",
      "globe/sphere/ellipsoid/geodesic-derived distance"
    ],
    "unit": "kilometres",
    "surveyTypes": {
      "direct-survey-baseline": {
        "measurementBasis": "adjusted-horizontal",
        "requiredFields": [
          "uncertaintyKm",
          "a.coordinateSource.provider",
          "a.coordinateSource.reference",
          "b.coordinateSource.provider",
          "b.coordinateSource.reference",
          "source.groupId"
        ]
      },
      "direct-survey-reduced-horizontal": {
        "measurementBasis": "sea-level-horizontal",
        "requiredFields": [
          "uncertaintyKm",
          "a.coordinateSource.provider",
          "a.coordinateSource.reference",
          "b.coordinateSource.provider",
          "b.coordinateSource.reference",
          "source.groupId"
        ]
      }
    },
    "surveySplitPolicy": "Keep complete survey baseline/site/network groups in one split."
  },
  "observations": []
}
